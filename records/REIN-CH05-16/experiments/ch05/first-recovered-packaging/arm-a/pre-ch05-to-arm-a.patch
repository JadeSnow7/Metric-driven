     }
 }
 
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(tag = "type", rename_all = "camelCase")]
+pub enum LoopEvent {
+    Started {
+        round: usize,
+    },
+    Model {
+        round: usize,
+        tool_call_ids: Vec<String>,
+        text: String,
+    },
+    Tool {
+        round: usize,
+        tool_call_id: String,
+        name: String,
+        result: ToolResult,
+    },
+    Stopped {
+        reason: StopReason,
+    },
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum StopReason {
+    Completed,
+    EmptyFinal,
+    ModelError,
+    MaxRounds,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LoopResult {
+    pub ok: bool,
+    pub answer: Option<String>,
+    pub reason: StopReason,
+    pub messages: Vec<Message>,
+    pub events: Vec<LoopEvent>,
+}
+
+pub trait LoopAdapter {
+    fn complete<'a>(
+        &'a mut self,
+        messages: &'a [Message],
+        tools: &'a [ToolDefinition],
+    ) -> Pin<Box<dyn Future<Output = Result<ModelTurn, ToolError>> + Send + 'a>>;
+}
+
+pub async fn run_agent_loop<A: LoopAdapter>(
+    adapter: &mut A,
+    initial: &[Message],
+    workspace: &Workspace,
+    tools: &[ToolDefinition],
+    max_rounds: usize,
+) -> LoopResult {
+    let mut messages = initial.to_vec();
+    let mut events = vec![LoopEvent::Started { round: 0 }];
+    for round in 1..=max_rounds {
+        let turn = match adapter.complete(&messages, tools).await {
+            Ok(turn) => turn,
+            Err(_) => {
+                events.push(LoopEvent::Stopped {
+                    reason: StopReason::ModelError,
+                });
+                return LoopResult {
+                    ok: false,
+                    answer: None,
+                    reason: StopReason::ModelError,
+                    messages,
+                    events,
+                };
+            }
+        };
+        let ids = turn.tool_calls.iter().map(|call| call.id.clone()).collect();
+        events.push(LoopEvent::Model {
+            round,
+            tool_call_ids: ids,
+            text: turn.message.content.clone(),
+        });
+        let final_text = turn.message.content.clone();
+        messages.push(turn.message);
+        if turn.tool_calls.is_empty() {
+            if final_text.trim().is_empty() {
+                events.push(LoopEvent::Stopped {
+                    reason: StopReason::EmptyFinal,
+                });
+                return LoopResult {
+                    ok: false,
+                    answer: None,
+                    reason: StopReason::EmptyFinal,
+                    messages,
+                    events,
+                };
+            }
+            let answer = final_text;
+            events.push(LoopEvent::Stopped {
+                reason: StopReason::Completed,
+            });
+            return LoopResult {
+                ok: true,
+                answer: Some(answer),
+                reason: StopReason::Completed,
+                messages,
+                events,
+            };
+        }
+        for call in turn.tool_calls {
+            let result = dispatch_readonly(&call, workspace);
+            let content = if result.ok {
+                result.output.clone().unwrap_or_default()
+            } else {
+                serde_json::json!({"error": result.error}).to_string()
+            };
+            messages.push(Message {
+                role: "tool".into(),
+                content,
+                tool_call_id: Some(result.tool_call_id.clone()),
+                tool_calls: Vec::new(),
+            });
+            events.push(LoopEvent::Tool {
+                round,
+                tool_call_id: call.id,
+                name: call.name,
+                result,
+            });
+        }
+    }
+    events.push(LoopEvent::Stopped {
+        reason: StopReason::MaxRounds,
+    });
+    LoopResult {
+        ok: false,
+        answer: None,
+        reason: StopReason::MaxRounds,
+        messages,
+        events,
+    }
+}
+
