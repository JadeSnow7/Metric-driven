+        std::fs::create_dir_all(&root).unwrap();
+        let call = ToolCall {
+            id: "bad".into(),
+            name: "unknown".into(),
+            arguments: serde_json::json!({}),
+        };
+        let mut adapter = Replay {
+            turns: vec![Ok(model("", vec![call]))],
+            index: 0,
+        };
+        let result =
+            run_agent_loop(&mut adapter, &[], &Workspace { root: root.clone() }, &[], 1).await;
+        assert_eq!(result.reason, StopReason::MaxRounds);
+        assert!(result.events.iter().any(|event| matches!(event, LoopEvent::Tool { result, .. } if result.error.as_ref().map(|error| error.code.as_str()) == Some("unknown_tool"))));
+        let _ = std::fs::remove_dir_all(root);
+    }
+
+    #[tokio::test]
+    async fn loop_distinguishes_model_error_and_empty_final() {
