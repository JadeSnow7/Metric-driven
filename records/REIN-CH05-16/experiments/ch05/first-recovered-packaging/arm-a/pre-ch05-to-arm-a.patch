+        let calls = vec![
+            ToolCall {
+                id: "a".into(),
+                name: "search_files".into(),
+                arguments: serde_json::json!({"needle":"真实"}),
+            },
+            ToolCall {
+                id: "b".into(),
+                name: "read_file".into(),
+                arguments: serde_json::json!({"path":"a.txt"}),
+            },
+        ];
+        let mut adapter = Replay {
+            turns: vec![Ok(model("", calls)), Ok(model("完成", vec![]))],
+            index: 0,
+        };
+        let result = run_agent_loop(
+            &mut adapter,
+            &[],
+            &Workspace { root: root.clone() },
+            &[],
+            32,
+        )
+        .await;
+        assert!(result.ok);
+        assert_eq!(
+            result
+                .events
+                .iter()
+                .filter_map(
+                    |event| if let LoopEvent::Tool { tool_call_id, .. } = event {
+                        Some(tool_call_id.as_str())
