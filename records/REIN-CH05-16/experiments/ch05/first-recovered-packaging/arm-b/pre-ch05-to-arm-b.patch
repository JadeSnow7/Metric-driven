+async fn tools_are_real_and_results_are_paired_in_order() {
+    let root = std::env::temp_dir().join(format!("rein-loop-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    std::fs::create_dir(&root).unwrap();
