+
+struct Replay(Arc<Mutex<Vec<String>>>);
+impl OpenAiHttp for Replay {
+    fn post<'a>(
+        &'a self,
+        _: &'a str,
+        _: &'a str,
+        _: serde_json::Value,
+    ) -> Pin<Box<dyn Future<Output = Result<String, ToolError>> + Send + 'a>> {
+        let response = self.0.lock().unwrap().remove(0);
+        Box::pin(async move { Ok(response) })
