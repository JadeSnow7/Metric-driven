+    assert!(sent.iter().any(|m| m.content == "goal"));
+    let prepared = result
+        .events
+        .iter()
+        .find_map(|e| {
+            if let LoopEvent::ContextPrepared {
+                kept_groups,
+                removed_groups,
+                ..
+            } = e
+            {
+                Some((kept_groups, removed_groups))
+            } else {
