+            })
+            .sum::<usize>()
+}
+
+/// The deterministic teaching estimate used by the chapter's offline adapter.
+pub fn estimated_units(messages: &[Message]) -> usize {
+    messages.iter().map(estimated_message).sum()
+}
+
+fn prepare_context(
+    messages: &[Message],
