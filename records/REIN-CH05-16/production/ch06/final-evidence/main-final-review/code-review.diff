+fn control_reason(signal: &ControlSignal, deadline: Option<Instant>) -> Option<StopReason> {
+    if signal.is_cancelled() {
+        Some(StopReason::Cancelled)
+    } else if deadline.is_some_and(|d| Instant::now() >= d) {
+        Some(StopReason::Timeout)
+    } else {
+        None
