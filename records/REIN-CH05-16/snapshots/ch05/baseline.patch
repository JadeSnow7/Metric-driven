+import { describe, expect, it } from 'vitest'
+import { loadConfig } from '../src/config'
+import { ConfigError } from '../src/errors'
+
+const complete = {
+  REIN_BASE_URL: 'https://api.example.com/v1',
+  REIN_API_KEY: 'sk-test',
+  REIN_MODEL: 'test-model',
