+const result = await runAgentLoop(createOpenAIAdapter(loadConfig(), createFetchTransport()), { root: resolve(process.argv[3] ?? '.') }, process.argv.slice(4).join(' ') || '请搜索 marker: 并读取命中文件', { maxTurns: 4 })
