+    try:
+        with path.open("w", encoding="utf-8", newline="") as handle:
+            writer = csv.writer(handle)
+            writer.writerow(["title", "done"])
+            for item in items:
+                writer.writerow([item["title"], "true" if item["done"] else "false"])
