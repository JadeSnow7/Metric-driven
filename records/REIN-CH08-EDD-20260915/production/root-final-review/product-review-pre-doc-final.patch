+if (strategy !== null) rustArgs.push(`--strategy=${strategy}`)
+const result = spawnSync('cargo', rustArgs, { cwd: root, encoding: 'utf8' })
+if (result.status !== 0) { process.stderr.write(result.stderr); process.exit(result.status ?? 1) }
